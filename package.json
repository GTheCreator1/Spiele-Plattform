{
  "name": "stichrunde",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "check": "tsc --noEmit && tsc --project tsconfig.worker.json",
    "build": "npm run check && vite build && node scripts/create-service-worker.mjs",
    "test": "node --experimental-strip-types --test vendor/xeri/tests/*.test.js tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "test:online": "playwright test --config playwright.online.config.ts",
    "dev:api": "wrangler dev --ip 127.0.0.1",
    "deploy:api": "wrangler deploy"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.13.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261124.2",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wrangler": "^4.168.0"
  }
}
